---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { loadData } from "../data/load";
import { todayUtc } from "../data/schema";
import { type Card, ogTags } from "../lib/og";
import { HOME_CARD_PATH, IS_PREVIEW } from "../lib/routes";
import { homeCard } from "../lib/share-card";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** The card shown when the page is shared; the scoreboard's when the page has none of its own. */
  card?: Card;
  /** The footer's correction link; a page that carries the source form points it there. */
  fonteHref?: string;
  /** The title X lays over the shared card; the page's title when absent. */
  xTitle?: string;
}

const { title, description, noindex = false, card, fonteHref = "/fonte/", xTitle } = Astro.props;
const d = loadData();
const { site } = d;
// The 404 page answers for addresses that do not exist, so it names no canonical address of its own.
const notFound = Astro.url.pathname.replace(/\/$/, "") === "/404";
const canonical = notFound ? null : new URL(Astro.url.pathname, Astro.site).toString();
const tags = ogTags({
  title,
  description,
  canonical,
  card: card ?? { path: HOME_CARD_PATH, model: homeCard(d, todayUtc()) },
  siteX: site.redes.x,
  xTitle,
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {tags.map((t) => ("property" in t ? <meta property={t.property} content={t.content} /> : <meta name={t.name} content={t.content} />))}
    {(noindex || IS_PREVIEW) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Runs before paint: marks that scripts run (so no-JS fallbacks hide without a flash), marks
      // a touch screen whose share sheet takes files (a desktop sheet may take them too, but it
      // reaches none of the phone's apps), and applies a saved theme; without one the stylesheet
      // follows the system.
      (function () {
        document.documentElement.classList.add("js");
        try {
          var card = new File([""], "cartao.png", { type: "image/png" });
          if (matchMedia("(pointer: coarse)").matches && navigator.canShare && navigator.canShare({ files: [card] }))
            document.documentElement.classList.add("share");
        } catch (e) {}
        var tema = null;
        try {
          tema = localStorage.getItem("tema");
        } catch (e) {}
        if (tema === "light" || tema === "dark") document.documentElement.dataset.theme = tema;
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-bg font-text text-fg">
    <Nav />
    <main class="mx-auto max-w-5xl px-4 py-6 sm:px-6">
      <slot />
    </main>
    <Footer repositorio={site.repositorio} fonteHref={fonteHref} />
  </body>
</html>
