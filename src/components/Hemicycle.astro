---
import { fillOrder, seats } from "../lib/hemicycle";
import { hemicycleLabel } from "../lib/text";

interface Props {
  declararam: number;
  mapeados: number;
  partido: number;
  total: number;
}

// A seat with no known position is an open ring (the mark's own shape). Seats with a position fill
// from the centre outward: the senator's own word first, then mapped support, then party support.
const { declararam, mapeados, partido, total } = Astro.props;
const all = seats();
const order = fillOrder();
const level = new Map<number, "declared" | "mapped" | "party">();
order.slice(0, declararam).forEach((i) => level.set(i, "declared"));
order.slice(declararam, declararam + mapeados).forEach((i) => level.set(i, "mapped"));
order.slice(declararam + mapeados, declararam + mapeados + partido).forEach((i) => level.set(i, "party"));
const label = hemicycleLabel({ declararam, mapeados, partido, total });
---

<svg viewBox="0 0 300 158" role="img" aria-label={label} class="block h-auto w-full">
  {
    all.map((s, i) => {
      const x = s.x.toFixed(1);
      const y = s.y.toFixed(1);
      switch (level.get(i)) {
        case "declared":
          return <circle cx={x} cy={y} r="6.2" fill="var(--color-declared)" />;
        case "mapped":
          return <circle cx={x} cy={y} r="6.2" fill="var(--color-mapped)" />;
        case "party":
          return <circle cx={x} cy={y} r="5.7" fill="var(--color-party)" stroke="var(--color-mapped)" stroke-width="1" />;
        default:
          return <circle cx={x} cy={y} r="5.2" fill="none" stroke="var(--color-undeclared)" stroke-width="2" />;
      }
    })
  }
</svg>
