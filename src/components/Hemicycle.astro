---
import { fillOrder, seats } from "../lib/hemicycle";

interface Props {
  declararam: number;
  total: number;
}

// An undeclared seat is an open ring (the mark's own shape); a declared seat is a filled disc.
const { declararam, total } = Astro.props;
const all = seats();
const declared = new Set(fillOrder().slice(0, declararam));
const label = `${total} cadeiras do Senado: ${total - declararam} não declararam, ${declararam} declararam`;
---

<svg viewBox="0 0 300 158" role="img" aria-label={label} class="block h-auto w-full">
  {
    all.map((s, i) =>
      declared.has(i) ? (
        <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r="6.2" fill="var(--color-declared)" />
      ) : (
        <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r="5.2" fill="none" stroke="var(--color-undeclared)" stroke-width="2" />
      ),
    )
  }
</svg>
