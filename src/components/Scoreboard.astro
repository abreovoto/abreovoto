---
import type { Placar } from "../data/placar";
import { todayUtc } from "../data/schema";
import { declaredCount, formatDate } from "../lib/text";
import Hemicycle from "./Hemicycle.astro";
import Icon from "./Icon.astro";

interface Props {
  placar: Placar;
  /** The address the "Copiar link" button copies; no button without it. */
  shareUrl?: string;
  /** What the button copies instead of the bare address: a ready-made post carrying `shareUrl`. */
  shareText?: string;
}

const { placar, shareUrl, shareText } = Astro.props;
// The date of the build: the scoreboard is as fresh as the last deploy.
const updated = formatDate(todayUtc());
const legend = [
  [declaredCount(placar.declararam), "bg-declared"],
  [`${placar.mapeados} apoio mapeado`, "bg-mapped"],
  [`${placar.partido} pelo partido`, "bg-party border border-mapped"],
] as const;
const numeral = "font-display block text-4xl tabular-nums min-[400px]:text-5xl min-[900px]:text-6xl";
---

<!-- Beside the home's headline (900 px up) the card takes the column's height: the hemicycle and the
     numbers sit in the middle of what is left, the footnote at the bottom edge. -->
<section class="flex flex-col rounded-lg bg-surface p-5 sm:p-6" aria-labelledby="placar">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="placar" class="text-lg font-semibold">Placar</h2>
    <p class="whitespace-nowrap text-xs text-fg-muted">atualizado em {updated}</p>
  </div>
  <div class="flex flex-1 flex-col justify-center">
    <div class="mt-5">
      <Hemicycle declararam={placar.declararam} mapeados={placar.mapeados} partido={placar.partido} total={placar.total} />
    </div>
    <div class="mt-3 grid grid-cols-2 text-center">
      <p class="px-2 py-1">
        <span class={`${numeral} text-undeclared`}>{placar.semPosicao}</span>
        <span class="mt-1.5 block text-sm font-semibold text-fg">sem posição conhecida</span>
      </p>
      <p class="border-l border-line px-2 py-1">
        <span class={`${numeral} text-declared`}>{placar.comPosicao}</span>
        <span class="mt-1.5 block text-sm font-semibold text-fg">com posição conhecida</span>
      </p>
    </div>
    <!-- How "com posição conhecida" splits: the senator's own word, mapped support, party support. -->
    <!-- Each item keeps its swatch beside its words; the swatches separate the items, so a wrapped line
         never starts with a separator. -->
    <p data-legenda class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-center text-xs text-fg-muted">
      {
        legend.map(([text, swatch]) => (
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
            <span class={`inline-block size-2.5 rounded-full ${swatch}`} aria-hidden="true" />
            {text}
          </span>
        ))
      }
    </p>
  </div>
  <div class="@container mt-5 flex items-center justify-between gap-x-2 gap-y-1 border-t border-line pt-3.5 text-xs text-fg-muted" data-share-actions>
    <p>{placar.total} senadores em exercício · 41 votos elegem</p>
    {
      shareUrl && (
        // The link carries the card's version, so a post made with it shows today's scoreboard; with a
        // text, the button copies the whole post around it.
        // Text-sized, so the row keeps its height; shown only when scripts run.
        <span class="flex shrink-0 items-center">
          <span role="status" aria-live="polite" data-share-status class="sr-only" />
          <button
            type="button"
            data-copy-link=""
            data-url={shareUrl}
            data-text={shareText}
            aria-label={shareText ? "Copiar texto para compartilhar" : "Copiar link"}
            class="group -m-2 hidden items-center gap-1 rounded-sm p-2 font-semibold text-fg-muted hover:text-fg [.js_&]:inline-flex"
          >
            <Icon name="link" class="size-3.5 shrink-0" />
            <!-- The word only where the row has room for it beside the note (the column narrows at 900 px
                 too); otherwise the icon alone, and the button keeps its name. -->
            <span class="hidden @min-[340px]:inline @min-[340px]:group-data-copied:hidden">copiar</span>
            <span class="hidden @min-[340px]:group-data-copied:inline" aria-hidden="true">copiado</span>
          </button>
        </span>
      )
    }
  </div>
</section>

<script>
  import "../scripts/share-actions";
</script>
