---
import type { Placar } from "../data/placar";
import { todayUtc } from "../data/schema";
import { formatDate } from "../lib/text";
import Hemicycle from "./Hemicycle.astro";

interface Props {
  placar: Placar;
}

const { placar } = Astro.props;
// The date of the build: the scoreboard is as fresh as the last deploy.
const updated = formatDate(todayUtc());
const numeral = "font-display block text-4xl tabular-nums min-[400px]:text-5xl min-[900px]:text-6xl";
---

<!-- Beside the home's headline (900 px up) the card takes the column's height: the hemicycle and the
     numbers sit in the middle of what is left, the footnote at the bottom edge. -->
<section class="flex flex-col rounded-lg bg-surface p-5 sm:p-6" aria-labelledby="placar">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="placar" class="text-lg font-semibold">Placar</h2>
    <p class="whitespace-nowrap text-xs text-fg-muted">atualizado em {updated}</p>
  </div>
  <div class="flex flex-1 flex-col justify-center">
    <div class="mt-5">
      <Hemicycle declararam={placar.declararam} total={placar.total} />
    </div>
    <div class="mt-3 grid grid-cols-2 text-center">
      <p class="px-2 py-1">
        <span class={`${numeral} text-undeclared`}>{placar.semPosicao}</span>
        <span class="mt-1.5 block text-sm font-semibold text-fg">não declararam</span>
      </p>
      <p class="border-l border-line px-2 py-1">
        <span class={`${numeral} text-declared`}>{placar.declararam}</span>
        <span class="mt-1.5 block text-sm font-semibold text-fg">declararam</span>
      </p>
    </div>
  </div>
  <p class="mt-5 border-t border-line pt-3.5 text-xs text-fg-muted">{placar.total} senadores em exercício · 41 votos elegem</p>
</section>
