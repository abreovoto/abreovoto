---
import type { Dataset } from "../data/load";
import { posicao } from "../data/posicao";
import type { Senador } from "../data/schema";
import { senatorPhoto } from "../lib/photos";
import { assumeEmNote, candidateBadge, departureNote, formatDate, partyState, positionSourceLabel, sourceHost } from "../lib/text";
import Portrait from "./Portrait.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  senador: Senador;
  d: Dataset;
  variant: "state" | "page";
  /** The senator's own page makes the name its h1; everywhere else it is an h3. */
  heading?: "h1" | "h3";
}

const { senador, d, variant, heading: Heading = "h3" } = Astro.props;
const departed = departureNote(senador);
const forecast = assumeEmNote(senador);
const p = posicao(senador, d);
const candidate = p.candidato === null ? null : d.candidatos.find((c) => c.id === p.candidato);
const badge = candidateBadge(senador, d.candidatos);
// Below the senator's own word the source line also names whose announcement or report it is.
const own = p.nivel === "declarou" || p.nivel === "mostrou_na_sessao";
const nameSize = variant === "page" ? "text-xl" : "text-lg";
---

<article class="flex h-full flex-col rounded-lg bg-surface p-5">
  <div class="flex items-start gap-4">
    <Portrait src={senatorPhoto(senador.id)} alt={`Foto oficial de ${senador.nome}`} size={variant} />
    <div class="min-w-0 flex-1">
      <Heading class={`${nameSize} font-semibold leading-tight text-fg`}>{senador.nome}</Heading>
      <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-fg-muted">
        <span>{partyState(senador)}</span>
        {badge && <span class="rounded-full border border-fg px-2 text-xs text-fg">{badge}</span>}
      </p>
      {forecast && <p class="mt-0.5 text-sm text-fg-muted">{forecast}</p>}
      {departed && <p class="mt-0.5 text-sm text-fg-muted">{departed}</p>}
      {
        !departed && (
          <div class="mt-3">
            <p class="flex flex-wrap items-baseline gap-x-2 text-sm">
              <StatusBadge posicao={p} />
              {candidate && <span class="font-semibold text-fg">{candidate.nome}</span>}
            </p>
            {p.nivel !== "nao_declarou" && (
              <p class="mt-1 break-words text-xs text-fg-muted">
                fonte: {!own && <>{positionSourceLabel(p)}, </>}
                <a href={p.fonte.url} rel="noopener noreferrer" class="text-accent underline">{sourceHost(p.fonte.url)}</a>, {formatDate(p.data)}
              </p>
            )}
          </div>
        )
      }
    </div>
  </div>
  {
    Astro.slots.has("actions") && (
      <div class="mt-auto flex flex-wrap gap-2 pt-4">
        <slot name="actions" />
      </div>
    )
  }
</article>
