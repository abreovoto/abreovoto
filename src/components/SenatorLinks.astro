---
import type { Senador } from "../data/schema";
import { senateProfileUrl } from "../lib/routes";
import { profileHandle } from "../lib/text";
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";

interface Props {
  senador: Senador;
}

type Row = { icon: "senado" | "email" | "x" | "instagram"; label: string; href: string; text: string; outbound: boolean };

// One row per channel the data has: the label with its icon, then the value — only the value is a link.
const { senador } = Astro.props;
const rows = [
  senador.codigo_senado && {
    icon: "senado",
    label: "Senado",
    href: senateProfileUrl(senador.codigo_senado),
    text: "Perfil oficial",
    outbound: true,
  },
  senador.email_institucional && {
    icon: "email",
    label: "E-mail",
    href: `mailto:${senador.email_institucional}`,
    text: senador.email_institucional,
    outbound: false,
  },
  senador.redes.x && { icon: "x", label: "X", href: senador.redes.x, text: profileHandle(senador.redes.x), outbound: true },
  senador.redes.instagram && {
    icon: "instagram",
    label: "Instagram",
    href: senador.redes.instagram,
    text: profileHandle(senador.redes.instagram),
    outbound: true,
  },
].filter((r): r is Row => Boolean(r));
---

{
  rows.length > 0 && (
    <section aria-labelledby="links">
      <SectionHead id="links" title="Links" />
      <dl class="mt-6 grid grid-cols-[auto_1fr] items-baseline gap-x-3 gap-y-3 sm:grid-cols-[8rem_1fr] sm:gap-x-6">
        {rows.map((r) => (
          <>
            <dt class="text-sm text-fg-muted">
              <Icon name={r.icon} class="inline-block size-4 align-[-0.2em] sm:mr-2" />
              <span class="max-sm:sr-only">{r.label}</span>
            </dt>
            <dd class="min-w-0 text-sm sm:text-base">
              <a href={r.href} rel={r.outbound ? "noopener noreferrer" : undefined} class="text-accent underline">
                {
                  r.icon === "email" ? (
                    <>
                      {r.text.split("@")[0]}@<wbr />
                      {r.text.split("@")[1]}
                    </>
                  ) : (
                    r.text
                  )
                }
              </a>
            </dd>
          </>
        ))}
      </dl>
    </section>
  )
}
