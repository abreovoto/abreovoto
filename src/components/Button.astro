---
interface Props {
  href?: string;
  kind: "primary" | "secondary";
  /** Height: `sm` 36 px, default 40 px, `lg` 48 px. */
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  rel?: string;
}

const { href, kind, size = "md", type = "button", rel } = Astro.props;
const base = "inline-flex items-center justify-center rounded border-2 text-sm font-semibold leading-none no-underline";
const height = size === "sm" ? "h-9 px-3" : size === "lg" ? "h-12 px-5" : "h-10 px-4";
const look = kind === "primary" ? "border-accent bg-accent text-on-accent" : "border-fg bg-transparent text-fg";
const classes = `${base} ${height} ${look}`;
---

{
  href ? (
    <a href={href} rel={rel} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
