---
import type { PlacarCandidato } from "../data/placar";
import { partyState } from "../lib/text";
import Portrait from "./Portrait.astro";

interface Props {
  candidato: PlacarCandidato;
  foto: ImageMetadata;
}

// Identical for every candidate: the number is the only variable.
const { candidato, foto } = Astro.props;
const label = candidato.total === 1 ? "declaração" : "declarações";
---

<article class="flex h-full flex-col rounded-lg bg-surface p-5 sm:p-6">
  <div class="flex items-start gap-3">
    <Portrait src={foto} alt={`Foto oficial de ${candidato.nome}`} size="state" />
    <div class="min-w-0">
      <h3 class="text-lg font-semibold leading-tight text-fg group-hover:underline">{candidato.nome}</h3>
      <p class="mt-0.5 text-sm text-fg-muted">{partyState(candidato)}</p>
    </div>
  </div>
  <!-- Pushed to the bottom so the three counts share a line whatever the names' length. -->
  <p class="mt-auto flex items-baseline gap-2.5 pt-6">
    <span class="font-display text-5xl tabular-nums text-fg">{candidato.total}</span>
    <span class="text-sm text-fg-muted">{label}</span>
  </p>
</article>
