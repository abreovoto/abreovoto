---
/**
 * Progressive enhancement. Without JavaScript the page has no `data-theme` and the
 * stylesheet follows the system preference; this button stays hidden. With it, the
 * button overrides the preference and remembers the choice in localStorage.tema.
 * Its label names the theme a click switches to.
 */
---

<button type="button" data-theme-toggle hidden class="rounded border-2 border-fg px-3 py-1 text-sm font-semibold text-fg">
  Tema escuro
</button>

<script>
  import { themeToggleLabel, type Theme } from "../lib/theme";

  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (button) {
    const root = document.documentElement;
    const system = window.matchMedia("(prefers-color-scheme: dark)");
    const current = (): Theme => (root.dataset.theme as Theme | undefined) ?? (system.matches ? "dark" : "light");
    const sync = () => {
      button.textContent = themeToggleLabel(current());
    };
    button.hidden = false;
    sync();
    system.addEventListener("change", sync);
    button.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("tema", next);
      } catch {
        // Storage can be unavailable (private mode, blocked); the toggle still works for this page.
      }
      sync();
    });
  }
</script>
