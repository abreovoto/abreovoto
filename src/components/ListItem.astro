---
import type { HTMLAttributes } from "astro/types";
import type { Dataset } from "../data/load";
import { posicao, proprioVoto } from "../data/posicao";
import type { Senador } from "../data/schema";
import { senatorPhoto } from "../lib/photos";
import { assumeEmNote, partyState } from "../lib/text";
import Portrait from "./Portrait.astro";
import Icon from "./Icon.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props extends HTMLAttributes<"li"> {
  senador: Senador;
  d: Dataset;
  /** When set, the name links here, and the link covers the whole row. */
  href?: string;
}

const { senador, d, href, ...rest } = Astro.props;
const p = posicao(senador, d);
const candidate = p.candidato === null ? null : d.candidatos.find((c) => c.id === p.candidato);
const forecast = assumeEmNote(senador);
// The row's call to action follows the level alone, never the candidate: ask whoever has not said it in
// their own words (mapped and party support included), show the source of whoever has — and of a candidacy.
const ask = !proprioVoto(p) && p.origem !== "candidatura";
const action = ask ? "Cobrar" : "Ver fonte";
---

<!-- Stripes count only the rows a filter leaves visible. With a link, its ::after
     covers the row, so a click anywhere opens the page while the row stays one link. -->
<li
  class:list={[
    "flex items-center gap-4 rounded-lg px-3 py-2.5 [&:nth-child(odd_of_:not([hidden]))]:bg-surface",
    href && "group relative",
  ]}
  {...rest}
>
  <Portrait src={senatorPhoto(senador.id)} alt={`Foto oficial de ${senador.nome}`} size="list" />
  <div class="min-w-0 flex-1 sm:flex sm:items-center sm:gap-4">
    <div class="min-w-0 sm:flex-1">
      <p class="text-base font-semibold leading-tight text-fg">
        {href ? <a href={href} class="row-link">{senador.nome}</a> : senador.nome}
      </p>
      <p class="text-sm text-fg-muted">
        {partyState(senador)}
        {forecast && <span>, {forecast}</span>}
      </p>
    </div>
    <p class="mt-1 flex flex-wrap items-baseline gap-x-2 text-sm sm:mt-0 sm:shrink-0">
      <StatusBadge posicao={p} />
      {candidate && <span class="font-semibold text-fg">{candidate.nome}</span>}
    </p>
  </div>
  {
    href && (
      <span
        data-action
        aria-hidden="true"
        class:list={[
          // Not a link of its own: clicks pass through to the row's link. Without this, the hover filter
          // lifts the pill above the link's ::after and swallows the click.
          "pointer-events-none inline-flex h-[36px] shrink-0 items-center gap-2 rounded border-2 px-3 text-sm font-semibold leading-none",
          ask
            ? "border-accent bg-accent text-on-accent group-hover:brightness-110"
            : "border-line text-fg-muted group-hover:border-fg group-hover:text-fg",
        ]}
      >
        {ask && <Icon name="megaphone" class="size-4 shrink-0" />}
        {action}
        {!ask && <Icon name="arrow" class="size-3.5 shrink-0" />}
      </span>
    )
  }
</li>
