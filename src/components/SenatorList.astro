---
import type { Dataset } from "../data/load";
import type { Senador } from "../data/schema";
import { UF } from "../data/schema";
import { CONTROL, FIELD, SELECT } from "../lib/controls";
import { senatorPath } from "../lib/routes";
import { ufName } from "../lib/uf";
import ListItem from "./ListItem.astro";
import SectionHead from "./SectionHead.astro";

interface Props {
  senadores: Senador[];
  d: Dataset;
}

const { senadores, d } = Astro.props;
const byName = (a: string, b: string) => a.localeCompare(b, "pt-BR");
const rows = [...senadores].sort((a, b) => byName(a.nome, b.nome));
const states = [...UF.options].sort((a, b) => byName(ufName(a), ufName(b)));
const parties = [...new Set(senadores.map((s) => s.partido))].sort(byName);
---

<section id="lista" aria-labelledby="lista-titulo">
  <!-- The heading is the call to action; the "Cobrar" at the end of each row says the rest. -->
  <SectionHead id="lista-titulo" title="Escolha um senador para cobrar" note={`${rows.length} senadores, em ordem alfabética`} />
  <form data-filtros hidden class="mt-6 grid gap-4 rounded-lg bg-surface p-4 sm:p-5" role="search" aria-label="Filtrar a lista">
    <fieldset>
      <legend class="text-sm font-semibold leading-tight text-fg">Mostrar</legend>
      <!-- Segmented buttons over visually hidden radios; the script still listens to the form's input events. -->
      <div class="mt-1.5 flex flex-wrap gap-2">
        {
          [
            ["todos", "Todos"],
            ["nao_declarou", "Não declararam"],
            ["declarou", "Declararam"],
          ].map(([value, label], i) => (
            <label class="inline-flex h-[36px] cursor-pointer items-center rounded border-2 border-line px-3.5 text-sm font-semibold text-fg has-checked:border-fg has-checked:bg-fg has-checked:text-bg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus">
              <input type="radio" name="status" value={value} checked={i === 0} class="sr-only" />
              {label}
            </label>
          ))
        }
      </div>
    </fieldset>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-[1fr_1fr_1.4fr]">
      <label class={FIELD}>
        Estado
        <select name="uf" class={SELECT}>
          <option value="">Todos os estados</option>
          {states.map((uf) => <option value={uf}>{ufName(uf)}</option>)}
        </select>
      </label>
      <label class={FIELD}>
        Partido
        <select name="partido" class={SELECT}>
          <option value="">Todos os partidos</option>
          {parties.map((p) => <option value={p}>{p}</option>)}
        </select>
      </label>
      <label class={FIELD}>
        Buscar por nome
        <input type="search" name="q" autocomplete="off" class={CONTROL} />
      </label>
    </div>
  </form>
  <p aria-live="polite" data-contagem class="mt-5 text-sm text-fg-muted">{rows.length} senadores</p>
  <ul class="mt-4" role="list" data-lista>
    {
      rows.map((s) => (
        <ListItem
          senador={s}
          d={d}
          href={senatorPath(s.id)}
          data-nome={s.nome}
          data-status={s.declaracao.status}
          data-candidato={s.declaracao.status === "nao_declarou" ? "" : s.declaracao.candidato}
          data-uf={s.uf}
          data-partido={s.partido}
        />
      ))
    }
  </ul>
</section>

<script>
  import { type ListFilter, type ListRow, matches } from "../lib/search";

  const form = document.querySelector<HTMLFormElement>("form[data-filtros]");
  const list = document.querySelector("ul[data-lista]");
  const count = document.querySelector("[data-contagem]");
  if (form && list && count) {
    const items = [...list.querySelectorAll<HTMLLIElement>("li[data-nome]")];
    const rows = items.map(
      (li): ListRow => ({
        nome: li.dataset.nome ?? "",
        status: (li.dataset.status ?? "nao_declarou") as ListRow["status"],
        candidato: li.dataset.candidato || null,
        uf: li.dataset.uf ?? "",
        partido: li.dataset.partido ?? "",
      }),
    );
    const label = (n: number) => (n === 0 ? "Nenhum senador com esses filtros" : n === 1 ? "1 senador" : `${n} senadores`);
    const apply = () => {
      const data = new FormData(form);
      const f: ListFilter = {
        status: (data.get("status") ?? "todos") as ListFilter["status"],
        uf: String(data.get("uf") ?? ""),
        partido: String(data.get("partido") ?? ""),
        q: String(data.get("q") ?? ""),
      };
      let shown = 0;
      rows.forEach((row, i) => {
        const ok = matches(row, f);
        items[i]!.hidden = !ok;
        if (ok) shown++;
      });
      count.textContent = label(shown);
    };
    form.hidden = false;
    form.addEventListener("input", apply);
    form.addEventListener("submit", (e) => e.preventDefault());
    // A browser that restored the controls on back navigation shows the matching rows.
    apply();
  }
</script>
