---
import type { Candidato, Senador } from "../data/schema";
import { UF } from "../data/schema";
import { senatorPath } from "../lib/routes";
import { ufName } from "../lib/uf";
import ListItem from "./ListItem.astro";

interface Props {
  senadores: Senador[];
  candidatos: Candidato[];
}

const { senadores, candidatos } = Astro.props;
const byName = (a: string, b: string) => a.localeCompare(b, "pt-BR");
const rows = [...senadores].sort((a, b) => byName(a.nome, b.nome));
const states = [...UF.options].sort((a, b) => byName(ufName(a), ufName(b)));
const parties = [...new Set(senadores.map((s) => s.partido))].sort(byName);
const control = "mt-1 block w-full rounded border-2 border-line bg-surface px-3 py-2 text-base text-fg sm:w-56";
---

<section id="lista" class="mt-10" aria-labelledby="lista-titulo">
  <h2 id="lista-titulo" class="text-2xl font-semibold">Os {rows.length} senadores</h2>
  <form data-filtros hidden class="mt-4 flex flex-wrap items-end gap-4" role="search" aria-label="Filtrar a lista">
    <fieldset class="w-full">
      <legend class="text-sm font-semibold text-fg">Mostrar</legend>
      <div class="mt-1 flex flex-wrap gap-x-5 gap-y-2 text-base">
        <label class="inline-flex items-center gap-2"><input type="radio" name="status" value="todos" checked class="accent-accent" /> Todos</label>
        <label class="inline-flex items-center gap-2"><input type="radio" name="status" value="nao_declarou" class="accent-accent" /> Não declararam</label>
        <label class="inline-flex items-center gap-2"><input type="radio" name="status" value="declarou" class="accent-accent" /> Declararam</label>
      </div>
    </fieldset>
    <label class="block w-full text-sm font-semibold text-fg sm:w-auto">
      Estado
      <select name="uf" class={control}>
        <option value="">Todos os estados</option>
        {states.map((uf) => <option value={uf}>{ufName(uf)}</option>)}
      </select>
    </label>
    <label class="block w-full text-sm font-semibold text-fg sm:w-auto">
      Partido
      <select name="partido" class={control}>
        <option value="">Todos os partidos</option>
        {parties.map((p) => <option value={p}>{p}</option>)}
      </select>
    </label>
    <label class="block w-full text-sm font-semibold text-fg sm:w-auto">
      Buscar por nome
      <input type="search" name="q" autocomplete="off" class={control} />
    </label>
  </form>
  <p aria-live="polite" data-contagem class="mt-4 text-sm text-fg-muted">{rows.length} senadores</p>
  <ul class="mt-2 max-w-3xl" role="list" data-lista>
    {
      rows.map((s) => (
        <ListItem
          senador={s}
          candidatos={candidatos}
          href={senatorPath(s.id)}
          data-nome={s.nome}
          data-status={s.declaracao.status}
          data-candidato={s.declaracao.status === "nao_declarou" ? "" : s.declaracao.candidato}
          data-uf={s.uf}
          data-partido={s.partido}
        />
      ))
    }
  </ul>
</section>

<script>
  import { type ListFilter, type ListRow, matches } from "../lib/search";

  const form = document.querySelector<HTMLFormElement>("form[data-filtros]");
  const list = document.querySelector("ul[data-lista]");
  const count = document.querySelector("[data-contagem]");
  if (form && list && count) {
    const items = [...list.querySelectorAll<HTMLLIElement>("li[data-nome]")];
    const rows = items.map(
      (li): ListRow => ({
        nome: li.dataset.nome ?? "",
        status: (li.dataset.status ?? "nao_declarou") as ListRow["status"],
        candidato: li.dataset.candidato || null,
        uf: li.dataset.uf ?? "",
        partido: li.dataset.partido ?? "",
      }),
    );
    const label = (n: number) => (n === 0 ? "Nenhum senador com esses filtros" : n === 1 ? "1 senador" : `${n} senadores`);
    const apply = () => {
      const data = new FormData(form);
      const f: ListFilter = {
        status: (data.get("status") ?? "todos") as ListFilter["status"],
        uf: String(data.get("uf") ?? ""),
        partido: String(data.get("partido") ?? ""),
        q: String(data.get("q") ?? ""),
      };
      let shown = 0;
      rows.forEach((row, i) => {
        const ok = matches(row, f);
        items[i]!.hidden = !ok;
        if (ok) shown++;
      });
      count.textContent = label(shown);
    };
    form.hidden = false;
    form.addEventListener("input", apply);
    form.addEventListener("submit", (e) => e.preventDefault());
    // A browser that restored the controls on back navigation shows the matching rows.
    apply();
  }
</script>
