---
/**
 * The actions that put a senator's card in circulation, the same for every senator.
 * `full` on the senator's page, in one order: X, Instagram, WhatsApp, copy, download;
 * `primary` on the state cards, where there is room for one action: X. The texts and the
 * card path travel as data attributes, so the script holds no text of its own.
 */
import type { Candidato, Senador, Site } from "../data/schema";
import { absolute, senatorCardPath, senatorPath } from "../lib/routes";
import { actionLabels, instagramText, thirdPersonText, whatsappUrl, xIntentUrl, xText } from "../lib/share-text";
import { departureNote } from "../lib/text";
import Button from "./Button.astro";

interface Props {
  senador: Senador;
  candidatos: Candidato[];
  site: Site;
  variant: "full" | "primary";
}

const { senador, candidatos, site, variant } = Astro.props;
const departed = departureNote(senador) !== null;
const full = variant === "full";
const size = full ? "md" : "sm";
const labels = actionLabels(senador);
const card = senatorCardPath(senador.id);
const file = `abreovoto-${senador.id}.png`;
---

{
  !departed && (
    <div class="contents" data-share-actions>
      <Button kind="primary" size={size} href={xIntentUrl(xText(senador, candidatos, site))} rel="noopener noreferrer" target="_blank">
        {labels.x}
      </Button>
      {full && (
        <Button
          kind="secondary"
          scripted
          data-share-instagram=""
          data-text={instagramText(senador, candidatos, site)}
          data-card={card}
          data-file={file}
        >
          {labels.instagram}
        </Button>
      )}
      {full && (
        <Button kind="secondary" href={whatsappUrl(thirdPersonText(senador, candidatos, site))} rel="noopener noreferrer" target="_blank">
          WhatsApp
        </Button>
      )}
      {full && (
        <Button kind="secondary" scripted data-copy-link="" data-url={absolute(senatorPath(senador.id))}>
          Copiar link
        </Button>
      )}
      {full && (
        <Button kind="secondary" href={card} download={file}>
          Baixar cartão
        </Button>
      )}
      {full && <p role="status" aria-live="polite" data-share-status class="basis-full text-sm text-fg-muted" />}
    </div>
  )
}

<script>
  import "../scripts/share-actions";
</script>
