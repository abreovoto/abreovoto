---
/**
 * The actions that put a senator's card in circulation, the same for every senator.
 * `full` on the senator's page, in one order: X, share the card (phones only), WhatsApp, copy,
 * download;
 * `primary` on the state cards, where there is room for one action: X. The texts and the
 * card path travel as data attributes, so the script holds no text of its own.
 */
import type { Candidato, Senador, Site } from "../data/schema";
import { senatorCardPath } from "../lib/routes";
import { shareUrl, thirdPersonText, whatsappUrl, xIntentUrl, xLabel, xText } from "../lib/share-text";
import { departureNote } from "../lib/text";
import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  senador: Senador;
  candidatos: Candidato[];
  site: Site;
  variant: "full" | "primary";
}

const { senador, candidatos, site, variant } = Astro.props;
const departed = departureNote(senador) !== null;
const full = variant === "full";
const third = thirdPersonText(senador, candidatos, site);
const card = senatorCardPath(senador.id);
const file = `abreovoto-${senador.id}.png`;
---

{
  !departed &&
    (full ? (
      // Two rows on purpose: the three networks, then the two utilities. Five buttons do
      // not fit the page column in one, and a lone wrapped button reads as an accident.
      <div class="flex basis-full flex-col gap-2" data-share-actions>
        <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
          <Button kind="primary" href={xIntentUrl(xText(senador, candidatos, site))} rel="noopener noreferrer" target="_blank">
            <Icon name="x" class="size-4 shrink-0" />
            {xLabel(senador)}
          </Button>
          <Button kind="secondary" scripted="share" data-share-card="" data-text={third} data-card={card} data-file={file}>
            <Icon name="share" class="size-4 shrink-0" />
            Compartilhar cartão
          </Button>
          <Button kind="secondary" href={whatsappUrl(third)} rel="noopener noreferrer" target="_blank">
            <Icon name="whatsapp" class="size-4 shrink-0" />
            WhatsApp
          </Button>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
          <Button kind="secondary" scripted data-copy-link="" data-url={shareUrl(senador)}>
            <Icon name="link" class="size-4 shrink-0" />
            Copiar link
          </Button>
          <Button kind="secondary" href={card} download={file}>
            <Icon name="download" class="size-4 shrink-0" />
            Baixar cartão
          </Button>
        </div>
        <p role="status" aria-live="polite" data-share-status class="text-sm text-fg-muted empty:hidden" />
      </div>
    ) : (
      <div class="contents" data-share-actions>
        <Button kind="primary" size="sm" href={xIntentUrl(xText(senador, candidatos, site))} rel="noopener noreferrer" target="_blank">
          <Icon name="x" class="size-4 shrink-0" />
          {xLabel(senador)}
        </Button>
      </div>
    ))
}

<script>
  import "../scripts/share-actions";
</script>
