---
import { UF, type UF as UFType } from "../data/schema";
import { FIELD, SELECT } from "../lib/controls";
import { ufName } from "../lib/uf";

interface Props {
  selected?: UFType;
}

// A native select, no script: later pages remember the choice and react to it.
const { selected } = Astro.props;
// By name, as the list's state filter: a voter looks for "São Paulo", not "SP".
const states = [...UF.options].sort((a, b) => ufName(a).localeCompare(ufName(b), "pt-BR"));
---

<label class={`${FIELD} w-full sm:w-64`}>
  Seu estado
  <select name="uf" class={SELECT}>
    <option value="" selected={selected === undefined}>Escolha o estado</option>
    {states.map((uf) => <option value={uf} selected={uf === selected}>{ufName(uf)}</option>)}
  </select>
</label>
