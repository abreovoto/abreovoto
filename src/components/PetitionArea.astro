---
import type { Peticao } from "../data/schema";
import { petitionView } from "../lib/petition";
import Button from "./Button.astro";

interface Props {
  peticao: Peticao;
}

const { peticao } = Astro.props;
// The live count arrives later; until then the manual figure decides.
const view = petitionView(peticao, null);
const count = view ? new Intl.NumberFormat("pt-BR").format(view.count) : "";
---

{
  view && (
    <div class="mt-7 max-w-lg border-t border-line pt-6">
      {view.showCount && (
        <p class="mb-4">
          <span class="font-display block text-4xl tabular-nums text-fg">{count}</span>
          <span class="mt-2 block max-w-[32ch] text-base text-fg">pessoas já pedem que os senadores declarem o voto antes da eleição</span>
        </p>
      )}
      <Button kind="primary" size="lg" href={view.url} rel="noopener">
        Assinar a petição
      </Button>
    </div>
  )
}
