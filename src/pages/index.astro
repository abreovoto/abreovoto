---
import CandidateCard from "../components/CandidateCard.astro";
import PetitionArea from "../components/PetitionArea.astro";
import SectionHead from "../components/SectionHead.astro";
import Scoreboard from "../components/Scoreboard.astro";
import SenatorList from "../components/SenatorList.astro";
import YourSenators from "../components/YourSenators.astro";
import { emExercicio, loadData } from "../data/load";
import { placar } from "../data/placar";
import { todayUtc } from "../data/schema";
import Base from "../layouts/Base.astro";
import { candidatePhoto } from "../lib/photos";
import { candidatePath } from "../lib/routes";
import { homeShareUrl } from "../lib/share-text";

const d = loadData();
const p = placar(d);
---

<Base title="Abre o Voto" description="Placar público da eleição para a Presidência do Senado Federal.">
  <div class="grid grid-cols-1 items-start gap-8 min-[900px]:grid-cols-[7fr_5fr] min-[900px]:items-stretch min-[900px]:gap-12">
    <div>
      <h1 class="max-w-[16ch] text-3xl font-semibold leading-tight sm:text-4xl">O seu voto é secreto. O deles não precisa ser.</h1>
      <!-- One measure for the subtitle and the petition block, so their right edges meet. -->
      <div class="max-w-[29rem]">
        <p class="mt-5 text-lg text-fg">
          Em 1º de fevereiro, seus senadores escolhem quem comanda o Senado, em voto secreto. Você tem o direito de saber em
          quem cada um vota. Cobre que declarem antes.
        </p>
        <PetitionArea peticao={d.peticao} />
      </div>
    </div>
    <Scoreboard placar={p} shareUrl={homeShareUrl(d, todayUtc())} />
  </div>

  <section aria-labelledby="candidatos">
    <SectionHead id="candidatos" title="Candidatos" note="41 votos elegem o presidente do Senado" />
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        p.porCandidato.map((c) => (
          <a href={candidatePath(c.id)} class="group block h-full no-underline">
            <CandidateCard candidato={c} foto={candidatePhoto(c.id)} />
          </a>
        ))
      }
    </div>
  </section>

  <YourSenators senadores={emExercicio(d)} d={d} />
  <SenatorList senadores={emExercicio(d)} d={d} />
  <PetitionArea peticao={d.peticao} placement="closing" />

  {
    d.site.ecidadania_url && (
      <section aria-labelledby="para-2029">
        <SectionHead id="para-2029" title="Para 2029" />
        <p class="mt-6 max-w-xl text-base text-fg-muted">
          Para que na próxima eleição isso não precise de campanha, há uma proposta de&nbsp;voto&nbsp;aberto na eleição
          da&nbsp;Mesa. <a href={d.site.ecidadania_url} rel="noopener noreferrer" class="text-accent underline">Apoie no e-Cidadania</a>.
        </p>
      </section>
    )
  }
</Base>
