---
import LandingStrip from "../../components/LandingStrip.astro";
import SectionHead from "../../components/SectionHead.astro";
import ShareActions from "../../components/ShareActions.astro";
import SenatorCard from "../../components/SenatorCard.astro";
import SenatorHistory from "../../components/SenatorHistory.astro";
import SenatorLinks from "../../components/SenatorLinks.astro";
import SourceForm from "../../components/SourceForm.astro";
import { FORM_TEXT, shortcutText } from "../../lib/source-form";
import { loadData } from "../../data/load";
import { placar } from "../../data/placar";
import { type Senador, todayUtc } from "../../data/schema";
import Base from "../../layouts/Base.astro";
import { candidatePath, senatorCardPath, senatorPath, statePath } from "../../lib/routes";
import { senatorCard } from "../../lib/share-card";
import { departureNote, formatDate, partyState, quoted, sourceHost, sourceTypeLabel, statusLabel } from "../../lib/text";
import { ufWithDe } from "../../lib/uf";

export function getStaticPaths() {
  return loadData().senadores.map((s) => ({ params: { id: s.id }, props: { senador: s } }));
}

interface Props {
  senador: Senador;
}

const { senador } = Astro.props;
const d = loadData();
const departed = departureNote(senador);
const decl = senador.declaracao;
const successor = senador.substituido_por ? d.senadores.find((s) => s.id === senador.substituido_por) : undefined;
// A running candidate's own senator page points at the candidate page, the same way for the three.
const asCandidate = d.candidatos.find((c) => c.senador === senador.id && c.situacao === "candidato");
const successorVerb = senador.deixou_em && todayUtc() < senador.deixou_em ? "Quem assume a vaga" : "Quem assumiu a vaga";
const description = `${senador.nome} (${partyState(senador)}) ${departed ?? statusLabel(senador, d.candidatos)}.`;

---

<Base
  title={`${senador.nome} — Abre o Voto`}
  description={description}
  card={{ path: senatorCardPath(senador.id), model: senatorCard(senador, d, todayUtc()) }}
  fonteHref="#fonte"
>
  <div class="max-w-2xl">
    <SenatorCard senador={senador} candidatos={d.candidatos} variant="page" heading="h1">
      {!departed && <ShareActions slot="actions" senador={senador} candidatos={d.candidatos} site={d.site} variant="full" />}
    </SenatorCard>

    {
      !departed && (
        <p class="mt-4 text-base">
          {shortcutText(senador.nome, decl.status !== "nao_declarou")} <a href="#fonte" class="text-accent underline">{FORM_TEXT.shortcutLink}</a>
        </p>
      )
    }

    <LandingStrip placar={placar(d)} peticao={d.peticao} />

    {
      departed && successor && (
        <p class="mt-6 text-base">
          {successorVerb}:{" "}
          <a href={senatorPath(successor.id)} class="text-accent underline">
            {successor.nome}
          </a>
        </p>
      )
    }

    {
      !departed && decl.status !== "nao_declarou" && (
        <section aria-labelledby="declaracao">
          <SectionHead id="declaracao" title="Declaração" />
          <dl class="mt-6 grid items-baseline gap-x-6 gap-y-2 text-base sm:grid-cols-[8rem_1fr]">
            <dt class="text-sm text-fg-muted">Data</dt>
            <dd class="tabular-nums">{formatDate(decl.data)}</dd>
            <dt class="text-sm text-fg-muted">Tipo de fonte</dt>
            <dd>{sourceTypeLabel(decl.fonte.tipo)}</dd>
            <dt class="text-sm text-fg-muted">Fonte</dt>
            <dd class="break-words">
              <a href={decl.fonte.url} rel="noopener noreferrer" class="text-accent underline">
                {decl.fonte.titulo ?? sourceHost(decl.fonte.url)}
              </a>
            </dd>
          </dl>
          <figure class="mt-6 rounded-lg bg-surface px-6 py-5">
            <blockquote class="text-base text-fg">{quoted(decl.fonte.trecho)}</blockquote>
            <figcaption class="mt-3 text-sm text-fg-muted">— {senador.nome}</figcaption>
          </figure>
        </section>
      )
    }

    <SenatorHistory senador={senador} repositorio={d.site.repositorio} />

    <SenatorLinks senador={senador} />

    <SourceForm site={d.site} senador={senador} />

    <p class="mt-16 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {
        asCandidate && (
          <a href={candidatePath(asCandidate.id)} class="text-accent underline">
            Declarações de voto em {asCandidate.nome}
          </a>
        )
      }
      <a href={statePath(senador.uf)} class="text-accent underline">Senadores {ufWithDe(senador.uf)}</a>
      <a href="/#lista" class="text-accent underline">Todos os 81 senadores</a>
    </p>
  </div>
</Base>
