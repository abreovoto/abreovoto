{
  "name": "abreovoto",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API reaches the Worker; every other path is served from dist/ directly.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Only the Worker's own outcome lines are kept: invocation logs would store each request's
  // headers, the visitor's IP among them.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // The site lives on the custom domain only; no *.workers.dev address.
  "workers_dev": false,
  "preview_urls": true,
  // Source-form submissions: 2 per minute per IP (the platform allows a period of 10 or 60 seconds).
  "ratelimits": [{ "name": "FONTE_LIMIT", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } }],
  // Petition counter: every 15 minutes, the Change.org total into one KV value.
  // Daily rebuild: 00:05 in Brasília, so date-dependent sentences follow the calendar (worker/rebuild.ts).
  "triggers": { "crons": ["*/15 * * * *", "5 3 * * *"] },
  // preview_id is what wrangler dev writes to; production is never written from a machine.
  "kv_namespaces": [{ "binding": "PETICAO_KV", "id": "823df51915864f7db97c06e3f96fe627", "preview_id": "651a8bb9111c4d72a0ed860470d0c99a" }],
  // Required by `wrangler preview`, which builds a preview for every pull request.
  // Previews do not inherit production bindings, so the limiter is declared here again.
  "previews": {
    "observability": { "enabled": true, "logs": { "invocation_logs": false } },
    // Source-form submissions: 2 per minute per IP (the platform allows a period of 10 or 60 seconds).
    "ratelimits": [{ "name": "FONTE_LIMIT", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } }],
    // A Preview serves the route from the test namespace; no cron runs there.
    "kv_namespaces": [{ "binding": "PETICAO_KV", "id": "651a8bb9111c4d72a0ed860470d0c99a" }]
  }
}
